{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tidesmm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidesmm-orders",
      "database_id": "cc652eba-3f76-49b6-ad3b-0badf0c2c36b"
    }
  ]
}
